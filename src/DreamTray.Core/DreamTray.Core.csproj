<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hardware access, settings persistence and the plugin loader. No UI beyond
       what the contracts drag in, so this stays testable from a console harness. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>DreamTray</RootNamespace>
    <AssemblyName>DreamTray.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.9.5 swapped WinRing0 for PawnIO (LHM PR #1857). Do not go back below it:
         WinRing0 is on Microsoft's vulnerable-driver blocklist and anti-cheats
         (EAC, BattlEye, Vanguard) refuse to run alongside a process holding it. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreamTray.Contracts\DreamTray.Contracts.csproj" />
  </ItemGroup>

</Project>
