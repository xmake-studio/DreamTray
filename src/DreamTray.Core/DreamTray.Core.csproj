<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hardware access, settings persistence and the plugin loader. No UI beyond
       what the contracts drag in, so this stays testable from a console harness. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>DreamTray</RootNamespace>
    <AssemblyName>DreamTray.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreamTray.Contracts\DreamTray.Contracts.csproj" />
  </ItemGroup>

</Project>
