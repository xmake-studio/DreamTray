<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DreamTray.App</RootNamespace>
    <AssemblyName>DreamTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The tray icon and panel are drawn natively; no WinForms interop layer. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreamTray.Contracts\DreamTray.Contracts.csproj" />
    <ProjectReference Include="..\DreamTray.Core\DreamTray.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="native\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build order only, and auto-discovered: every "plugins\<Folder>\*.csproj"
         gets built before DreamTray.App, with no per-plugin edit needed here.
         The plugin is loaded from disk at runtime through its own
         AssemblyLoadContext (see PluginManager), so referencing its assembly
         here would defeat the isolation the plugin system exists to provide. -->
    <ProjectReference Include="..\..\plugins\*\*.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Stage every discovered plugin where PluginManager.LoadAll() looks for it:
       plugins\<name>\. One target definition, no per-plugin block: add a new
       project under plugins\ and it is picked up automatically, for both a
       plain build (AfterTargets="Build", into $(OutDir)) and `dotnet publish`
       (AfterTargets="Publish", into $(PublishDir); Build's own $(OutDir) is an
       intermediate folder that publish.bat's `-o dist` never reads). -->
  <Target Name="_DiscoverBundledPlugins">
    <ItemGroup>
      <_PluginProject Include="..\..\plugins\*\*.csproj" />
      <!-- One glob per discovered project, tagged with a short staging name
           (the "DreamTray.Plugin." prefix dropped, e.g. "CyberVfd"). MSBuild
           batches this Include once per distinct %(_PluginProject.*) group, so
           each plugin's own bin folder is expanded separately and correctly. -->
      <_PluginOutput Include="%(_PluginProject.RootDir)%(_PluginProject.Directory)bin\$(Configuration)\$(TargetFramework)\**\*">
        <StageName>$([System.String]::Copy('%(_PluginProject.Filename)').Replace('DreamTray.Plugin.', ''))</StageName>
      </_PluginOutput>
    </ItemGroup>
  </Target>

  <Target Name="StageBundledPluginsForBuild" AfterTargets="Build" DependsOnTargets="_DiscoverBundledPlugins">
    <Copy SourceFiles="@(_PluginOutput)"
          DestinationFolder="$(OutDir)plugins\%(StageName)\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_PluginOutput)' != ''" />
  </Target>

  <Target Name="StageBundledPluginsForPublish" AfterTargets="Publish" DependsOnTargets="_DiscoverBundledPlugins">
    <Copy SourceFiles="@(_PluginOutput)"
          DestinationFolder="$(PublishDir)plugins\%(StageName)\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_PluginOutput)' != ''" />
  </Target>

</Project>
